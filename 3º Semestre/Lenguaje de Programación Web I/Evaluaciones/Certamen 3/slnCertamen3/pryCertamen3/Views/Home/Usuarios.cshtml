@{
    ViewData["Title"] = "Usuarios";
}

<script>
    $(document).ready(function (){
        cargarUsuarios()
        $("#btnAccion").text("Registrar usuario").on("click", registrarUsuario)
    });

    function registrarUsuario() {
        const usuario = $("#txtUsuario").val()
        const nombre = $("#txtNombre").val()
        const estado = $("#cmbEstado").val()
        const contraseña = $("#txtContraseña").val()
        const repContraseña = $("#txtRepContraseña").val()

        if (usuario == "") {
            alert("Usuario no puede encontrarse vacío")
            return
        }

        if (nombre == "") {
            alert("Nombre no puede encontrarse vacío")
            return
        }

        if (estado == "") {
            alert("Debe seleccionar un estado")
            return
        }

        if (contraseña == "" || repContraseña == "") {
            alert("Contraseña no puede encontrarse vacía")
            return
        }

        if (contraseña != repContraseña) {
            alert("Las contraseñas no coiciden")
            return
        }

        $.ajax({
            url: "/Home/registrarUsuario",
            method: "POST",
            data: {
                USUARIO: usuario,
                NOMBRE: nombre,
                IDESTADO: estado,
                CONTRASEÑA: contraseña
            },
            success: function(response) {
                if (response != "OK") {
                    alert(response);
                    return;
                }
                
                cargarUsuarios()
                limpiar()
            }
        })
    }

    function cargarUsuarios() {
        $.ajax({
            url: "/Home/cargarUsuarios",
            method: "GET",
            success: function(response) {
                var tablaHtml = ""

                $.each(response, function(key, value) {
                    tablaHtml += "<tr>"
                        tablaHtml += "<td>" + value.usuario + "</td>"
                        tablaHtml += "<td>" + value.nombre + "</td>"

                        if (value.estado == 1) {
                             tablaHtml += "<td>Habilitado</td>"
                        } else {
                            tablaHtml += "<td>Deshabilitado</td>"
                        }

                        tablaHtml += "<td> <button class='btn btn-sm btn-warning' id='btnEditar' onclick='editarUsuario(\"" + value.usuario + "\", \"" + value.nombre + "\", \"" + value.estado + "\", \"" + value.contraseña + "\")'>Editar</button> </td>"
                    tablaHtml += "</tr>"
                });

                $("#tbUsuarios").html(tablaHtml);
            }
        })
    }

    function editarUsuario(usuario, nombre, estado, contraseña) {
        $("#txtUsuario").prop("disabled", true).val(usuario)
        $("#txtNombre").val(nombre)
        $("#cmbEstado").val(estado)
        $("#txtContraseña").val(contraseña)
        $("#txtRepContraseña").val(contraseña)

        $("#btnAccion").text("Editar usuario").off("click").on("click", function() {
            const e_nombre = $("#txtNombre").val()
            const e_estado = $("#cmbEstado").val()
            const e_contraseña = $("#txtContraseña").val()
            const e_repContraseña = $("#txtRepContraseña").val()

            if (e_nombre == "") {
                alert("Nombre no puede encontrarse vacío")
                return
            }

            if (e_contraseña == "" || e_repContraseña == "") {
                alert("Contraseña no puede encontrarse vacía")
                return
            }

            if (e_contraseña != e_repContraseña) {
                alert("Las contraseñas no coinciden")
                return;
            }

            $.ajax({
                url: "/Home/editarUsuario",
                method: "POST",
                data: {
                    USUARIO: usuario,
                    NOMBRE: e_nombre,
                    IDESTADO: e_estado,
                    CONTRASEÑA: e_contraseña
                },
                success: function(response) {
                    if (response != "OK") {
                        alert(response);
                        return;
                    }

                    cargarUsuarios()
                    limpiar()

                    $("#txtUsuario").prop("disabled", false)

                    $("#btnAccion").text("Registrar usuario").off("click").on("click", registrarUsuario)
                }
            })
        })
    }

    function limpiar() {
        $("#txtUsuario").val("")
        $("#txtNombre").val("")
        $("#cmbEstado").val("")
        $("#txtContraseña").val("")
        $("#txtRepContraseña").val("")
    }
</script>

<div class="text-center">
    <h2 id="lblTitulo">Registro de usuarios</h2>

    <div class="row justify-content-center">
        <div class="col-auto">
            <div id="dvUsuario" class="row mb-3 mt-4 align-items-center">
                <label class="form-label col-4 text-end" for="txtUsuario">Usuario:</label>

                <div class="col-7">
                    <input class="form-control" type="text" maxlength="20" id="txtUsuario" />
                </div>
            </div> <!-- Usuario -->

            <div id="dvNombre" class="row mb-3 mt-4 align-items-center">
                <label class="form-label col-4 text-end" for="txtNombre">Nombre:</label>

                <div class="col-7">
                    <input class="form-control" type="text" maxlength="50" id="txtNombre" />
                </div>
            </div> <!-- Nombre -->

            <div id="dvEstado" class="row mb-3 align-items-center">
                <label class="form-label col-4 text-end" for="cmbEstado">Estado:</label>

                <div class="col-7">
                    <select class="form-select" name="opciones" id="cmbEstado">
                        <option hidden value="">Eliga una opción...</option>
                        <option value="1">Habilitado</option>
                        <option value="2">Deshabilitado</option>
                    </select>
                </div>
            </div> <!-- Estado -->

            <div id="dvContraseña" class="row mb-3 align-items-center">
                <label class="form-label col-4 text-end" for="txtContraseña">Contraseña:</label>

                <div class="col-7">
                    <input class="form-control" type="password" maxlength="20" id="txtContraseña" />
                </div>
            </div> <!-- Contraseña -->

            <div id="dvRepContraseña" class="row mb-3 align-items-center">
                <label class="form-label col-4 text-end" for="txtRepContraseña">Repetir contraseña:</label>

                <div class="col-7">
                    <input class="form-control" type="password" maxlength="20" id="txtRepContraseña" />
                </div>
            </div> <!-- Contraseña Repetida -->

            <button class="btn btn-primary mb-5" id="btnAccion"></button> <!-- Botón de acción (Registrar y editar) -->
        </div>

        <table class="table">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Usuario</th>
                    <th scope="col">Nombre de Persona</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Editar</th>
                </tr>
            </thead>
            <tbody id="tbUsuarios">
            </tbody>
        </table> <!-- Tabla de usuarios -->
    </div>
</div>